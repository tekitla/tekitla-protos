{
  "name": "@tekitla/tekitla-protos",
  "version": "0.3.0",
  "description": "Contratos gRPC de Tekitla (tekitla-protos): mensajes y servicios protobuf-es v2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tekitla/tekitla-protos.git",
    "directory": "gen/ts"
  },
  "files": [
    "lib"
  ],
  "exports": {
    "./*": {
      "types": "./lib/*.d.ts",
      "default": "./lib/*.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0"
  },
  "devDependencies": {
    "typescript": "~7.0.2"
  }
}

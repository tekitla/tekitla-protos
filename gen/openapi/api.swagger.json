    "IssueServiceMoveIssueBody": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "#/definitions/v1IssueState",
          "description": "Categoría destino, para los clientes que no conocen los estados del\nproyecto: el issue va al primer estado de esa categoría (si ya está en\nesa categoría, no cambia de estado). Se ignora si viene status_id.\nUNSPECIFIED sin status_id es INVALID_ARGUMENT."
        },
        "statusId": {
          "type": "string",
          "description": "Estado destino. Uno de otro proyecto es INVALID_ARGUMENT."
        },
        "beforeNumber": {
          "type": "integer",
          "format": "int32",
          "description": "Lugar dentro de la columna destino, tal como el cliente la ve: debajo de\nafter_number y arriba de before_number (0 = sin vecino de ese lado). Con\nlos dos en 0 conserva su rank. FAILED_PRECONDITION si los vecinos ya no\nestán en esa columna o en ese orden (la vista está vieja: recargar)."
        },
        "afterNumber": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "IssueServiceUpdateIssueBody": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Solo cambia lo que viene. Título vacío es INVALID_ARGUMENT."
        },
        "description": {
          "type": "string"
        },
        "priority": {
          "$ref": "#/definitions/v1Priority",
          "description": "UNSPECIFIED es INVALID_ARGUMENT."
        },
        "labels": {
          "$ref": "#/definitions/v1LabelIds",
          "description": "Reemplaza las etiquetas del issue; ausente, no cambian. Una etiqueta de\notro proyecto es INVALID_ARGUMENT."
        }

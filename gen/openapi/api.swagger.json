{
  "swagger": "2.0",
  "info": {
    "title": "issues/v1/issues.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "IssueService",
      "description": "IssueService gestiona los proyectos y sus issues.\n\nTodo acceso se limita a los espacios de trabajo del usuario autenticado (el\ngateway propaga su identidad en la metadata). En la rebanada 1 cada usuario\ntiene solo su espacio personal; desde la rebanada 3 un espacio es un tenant\nde la plataforma (issue 005) y workspace_id es su id. Un proyecto ajeno o no\nvisible para el usuario responde NOT_FOUND, nunca PERMISSION_DENIED, para no\nrevelar que existe.\n\nLas opciones google.api.http definen las rutas REST que expone el\napi-gateway (grpc-gateway). Una ruta anotada NO queda pública por estar\nacá: el gateway la expone solo si figura en su routes.yaml."
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/projects": {
      "get": {
        "summary": "Lista los proyectos visibles para el usuario en todos sus espacios de\ntrabajo (o en uno, con workspace_id), ordenados por nombre.",
        "operationId": "IssueService_ListProjects",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListProjectsResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "page.cursor",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "page.limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "workspaceId",
            "description": "Vacío: todos los espacios del usuario. Un espacio ajeno devuelve la lista\nvacía, no un error, para no revelar que existe.",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "IssueService"
        ]
      },
      "post": {
        "summary": "Crea un proyecto. ALREADY_EXISTS si el espacio de trabajo ya tiene uno con\nesa key.",
        "operationId": "IssueService_CreateProject",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CreateProjectResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1CreateProjectRequest"
            }
          }
        ],
        "tags": [
          "IssueService"
        ]
      }
    },
    "/v1/projects/{projectId}/issues": {
      "get": {
        "summary": "Lista los issues de un proyecto, opcionalmente filtrados por estado.\nOrden: rank ascendente (el orden manual del backlog y de cada columna).",
        "operationId": "IssueService_ListIssues",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListIssuesResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "state",
            "description": "UNSPECIFIED: todos los estados.\n\n - ISSUE_STATE_TODO: Por hacer.\n - ISSUE_STATE_IN_PROGRESS: En curso.\n - ISSUE_STATE_DONE: Hecho.\n - ISSUE_STATE_CANCELED: Descartado: cerrado sin hacerse.",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "ISSUE_STATE_UNSPECIFIED",
              "ISSUE_STATE_TODO",
              "ISSUE_STATE_IN_PROGRESS",
              "ISSUE_STATE_DONE",
              "ISSUE_STATE_CANCELED"
            ],
            "default": "ISSUE_STATE_UNSPECIFIED"
          },
          {
            "name": "page.cursor",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "page.limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "IssueService"
        ]
      },
      "post": {
        "summary": "Crea un issue en ISSUE_STATE_TODO con el siguiente número del proyecto y\nlo ubica al final del orden (rank mayor que el de todos los demás).",
        "operationId": "IssueService_CreateIssue",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CreateIssueResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/IssueServiceCreateIssueBody"
            }
          }
        ],
        "tags": [
          "IssueService"
        ]
      }
    },
    "/v1/projects/{projectId}/issues/{number}": {
      "get": {
        "summary": "Devuelve un issue por su número dentro del proyecto.",
        "operationId": "IssueService_GetIssue",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetIssueResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "number",
            "in": "path",
            "required": true,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "IssueService"
        ]
      }
    },
    "/v1/projects/{projectId}/issues/{number}:move": {
      "post": {
        "summary": "Cambia el estado de un issue (mover de columna en el tablero).",
        "operationId": "IssueService_MoveIssue",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1MoveIssueResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "number",
            "in": "path",
            "required": true,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/IssueServiceMoveIssueBody"
            }
          }
        ],
        "tags": [
          "IssueService"
        ]
      }
    }
  },
  "definitions": {
    "IssueServiceCreateIssueBody": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "priority": {
          "$ref": "#/definitions/v1Priority"
        }
      }
    },
    "IssueServiceMoveIssueBody": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "#/definitions/v1IssueState",
          "description": "Estado destino; UNSPECIFIED es INVALID_ARGUMENT."
        }
      }
    },
    "v1CreateIssueResponse": {
      "type": "object",
      "properties": {
        "issue": {
          "$ref": "#/definitions/v1Issue"
        }
      }
    },
    "v1CreateProjectRequest": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "workspaceId": {
          "type": "string",
          "description": "Vacío: el espacio personal del usuario (el único en la rebanada 1)."
        }
      }
    },
    "v1CreateProjectResponse": {
      "type": "object",
      "properties": {
        "project": {
          "$ref": "#/definitions/v1Project"
        }
      }
    },
    "v1GetIssueResponse": {
      "type": "object",
      "properties": {
        "issue": {
          "$ref": "#/definitions/v1Issue"
        }
      }
    },
    "v1Issue": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "number": {
          "type": "integer",
          "format": "int32",
          "description": "Número correlativo dentro del proyecto, desde 1. No se reutiliza."
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "description": "Markdown."
        },
        "state": {
          "$ref": "#/definitions/v1IssueState"
        },
        "priority": {
          "$ref": "#/definitions/v1Priority"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "rank": {
          "type": "string",
          "description": "Posición en el orden manual del proyecto, opaca. Se compara como string\n(orden lexicográfico); el cliente no la calcula ni la interpreta. El orden\nde una columna es el de sus issues por rank."
        }
      }
    },
    "v1IssueState": {
      "type": "string",
      "enum": [
        "ISSUE_STATE_UNSPECIFIED",
        "ISSUE_STATE_TODO",
        "ISSUE_STATE_IN_PROGRESS",
        "ISSUE_STATE_DONE",
        "ISSUE_STATE_CANCELED"
      ],
      "default": "ISSUE_STATE_UNSPECIFIED",
      "description": "Categoría del estado de un issue. Es fija y la entienden todos los clientes\nsin importar la metodología del proyecto: `tq start` mueve a IN_PROGRESS,\nlos reportes cuentan como cerrados DONE y CANCELED.\n\nEn la rebanada 1 hay un estado por categoría y cada uno es una columna del\ntablero. Con estados configurables por proyecto (Kanban, Scrum, marketing),\ncada estado concreto llega como un campo nuevo (status_id) y pertenece a una\nde estas categorías; varias columnas pueden compartir categoría.\n\n - ISSUE_STATE_TODO: Por hacer.\n - ISSUE_STATE_IN_PROGRESS: En curso.\n - ISSUE_STATE_DONE: Hecho.\n - ISSUE_STATE_CANCELED: Descartado: cerrado sin hacerse."
    },
    "v1ListIssuesResponse": {
      "type": "object",
      "properties": {
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Issue"
          }
        },
        "page": {
          "$ref": "#/definitions/v1PageResponse"
        }
      }
    },
    "v1ListProjectsResponse": {
      "type": "object",
      "properties": {
        "projects": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Project"
          }
        },
        "page": {
          "$ref": "#/definitions/v1PageResponse"
        }
      }
    },
    "v1MoveIssueResponse": {
      "type": "object",
      "properties": {
        "issue": {
          "$ref": "#/definitions/v1Issue"
        }
      }
    },
    "v1PageRequest": {
      "type": "object",
      "properties": {
        "cursor": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "format": "int32"
        }
      },
      "description": "PageRequest: paginación por cursor opaco. limit \u003c= 0 usa el default del servicio."
    },
    "v1PageResponse": {
      "type": "object",
      "properties": {
        "nextCursor": {
          "type": "string"
        },
        "hasNext": {
          "type": "boolean"
        }
      },
      "description": "PageResponse: next_cursor vacío y has_next=false en la última página."
    },
    "v1Priority": {
      "type": "string",
      "enum": [
        "PRIORITY_UNSPECIFIED",
        "PRIORITY_LOW",
        "PRIORITY_MEDIUM",
        "PRIORITY_HIGH",
        "PRIORITY_URGENT"
      ],
      "default": "PRIORITY_UNSPECIFIED",
      "description": "Prioridad de un issue. Al crear, UNSPECIFIED se guarda como MEDIUM."
    },
    "v1Project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "description": "Clave corta y única por espacio de trabajo, en mayúsculas (2 a 10 letras o dígitos,\nempieza con letra), p. ej. \"TQ\". Los issues se nombran TQ-42."
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "workspaceId": {
          "type": "string",
          "description": "Espacio de trabajo dueño del proyecto (personal o de un equipo). En la\nrebanada 1 siempre es el espacio personal del usuario."
        }
      }
    }
  }
}

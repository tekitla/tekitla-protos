{
  "swagger": "2.0",
  "info": {
    "title": "issues/v1/issues.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "IssueService",
      "description": "IssueService gestiona los proyectos y sus issues.\n\nTodo acceso se limita a los espacios de trabajo del usuario autenticado (el\ngateway propaga su identidad en la metadata). En la rebanada 1 cada usuario\ntiene solo su espacio personal; desde la rebanada 3 un espacio es un tenant\nde la plataforma (issue 005) y workspace_id es su id. Un proyecto ajeno o no\nvisible para el usuario responde NOT_FOUND, nunca PERMISSION_DENIED, para no\nrevelar que existe.\n\nLas opciones google.api.http definen las rutas REST que expone el\napi-gateway (grpc-gateway). Una ruta anotada NO queda pública por estar\nacá: el gateway la expone solo si figura en su routes.yaml."
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/projects": {
      "get": {
        "summary": "Lista los proyectos visibles para el usuario en todos sus espacios de\ntrabajo (o en uno, con workspace_id), ordenados por nombre.",
        "operationId": "IssueService_ListProjects",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListProjectsResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "page.cursor",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "page.limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "workspaceId",
            "description": "Vacío: todos los espacios del usuario. Un espacio ajeno devuelve la lista\nvacía, no un error, para no revelar que existe.",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "IssueService"
        ]
      },
      "post": {
        "summary": "Crea un proyecto. ALREADY_EXISTS si el espacio de trabajo ya tiene uno con\nesa key.",
        "operationId": "IssueService_CreateProject",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CreateProjectResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1CreateProjectRequest"
            }
          }
        ],
        "tags": [
          "IssueService"
        ]
      }
    },
    "/v1/projects/{projectId}/issues": {
      "get": {
        "summary": "Lista los issues de un proyecto, opcionalmente filtrados por estado.\nOrden: rank ascendente (el orden manual del backlog y de cada columna).",
        "operationId": "IssueService_ListIssues",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListIssuesResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "state",
            "description": "UNSPECIFIED: todos los estados.\n\n - ISSUE_STATE_TODO: Por hacer.\n - ISSUE_STATE_IN_PROGRESS: En curso.\n - ISSUE_STATE_DONE: Hecho.\n - ISSUE_STATE_CANCELED: Descartado: cerrado sin hacerse.",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "ISSUE_STATE_UNSPECIFIED",
              "ISSUE_STATE_TODO",
              "ISSUE_STATE_IN_PROGRESS",
              "ISSUE_STATE_DONE",
              "ISSUE_STATE_CANCELED"
            ],
            "default": "ISSUE_STATE_UNSPECIFIED"
          },
          {
            "name": "page.cursor",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "page.limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "IssueService"
        ]
      },
      "post": {
        "summary": "Crea un issue en ISSUE_STATE_TODO con el siguiente número del proyecto y\nlo ubica al final del orden (rank mayor que el de todos los demás).",
        "operationId": "IssueService_CreateIssue",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CreateIssueResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/IssueServiceCreateIssueBody"
            }
          }
        ],
        "tags": [
          "IssueService"
        ]
      }
    },
